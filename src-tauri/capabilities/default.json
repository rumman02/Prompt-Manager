{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window, including custom-region window dragging.",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}
